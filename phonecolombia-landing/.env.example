# URL de la API Laravel (backend)
VITE_API_URL=http://localhost:8000/api

# Instrucciones:
# 1. Copia este archivo a `.env` en la raíz del proyecto.
# 2. Asegúrate de que el backend Laravel esté corriendo en el puerto indicado.
# 3. Reinicia el servidor de desarrollo: `npm run dev`.

# NO subas el archivo `.env` a repositorios públicos.
