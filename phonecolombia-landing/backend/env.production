# =============================================================================
# BACKEND — PRODUCCIÓN (Hostinger)
# Copia a .env en el servidor (o renombra al subir):
#   copy env.production .env
# Completa DB_* con los datos de hPanel → Bases de datos MySQL
# En el servidor ejecuta (SSH):
#   php artisan key:generate   (solo si APP_KEY está vacío)
#   php artisan migrate --force
#   php artisan storage:link
#   php artisan config:cache
# =============================================================================

APP_NAME="Phone Colombia API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.phonecolombia.com
FRONTEND_URL=https://phonecolombia.com

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_phonecolombia
DB_USERNAME=u123456789_user
DB_PASSWORD=CAMBIA_ESTA_CONTRASEÑA

FILESYSTEM_DISK=public

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=file
LOG_CHANNEL=stack
LOG_LEVEL=error
