# =============================================================================
# BACKEND — PRODUCCIÓN (Hostinger, plan Single, sin SSH)
# En el servidor este archivo debe llamarse .env (dentro de public_html/backend)
#
# SUBDOMINIO api (obligatorio — si no, verás error CORS en el login):
#   hPanel → Sitios web → phonecolombia.com → Subdominios → api
#   → Carpeta del subdominio: public_html/backend/public
#
# PHP (obligatorio — Laravel 12 requiere 8.2+):
#   hPanel → Sitios web → phonecolombia.com → Administración → Versión de PHP
#   → Elige PHP 8.2 o 8.3 (si está en 8.1 verás error 500 y CORS en el navegador)
#
# Pasos SIN terminal:
#   1) Sube el backend a public_html/backend (con vendor/ incluido)
#   2) Renombra este archivo a .env y completa los DB_* de hPanel
#   2b) En el servidor debe existir SOLO .env (borra .env.production si lo subiste)
#       Si Hostinger define APP_ENV=production, Laravel carga .env.production y no .env
#   3) Importa tu dump de MySQL en la BD creada en hPanel
#   4) Borra public_html/backend/bootstrap/cache/config.php si existe
#   4b) Sube caché de producción: public/fix-production-cache.php + public/production-bootstrap-cache/
#       y abre https://api.phonecolombia.com/fix-production-cache.php
#       (evita que Laravel registre Pail/Sail/Collision de vendor de desarrollo)
#   4c) Ideal: sube vendor/ generado con `composer install --no-dev` en tu PC
#   5) Prueba https://api.phonecolombia.com/api/products (debe dar JSON, no HTML)
# La APP_KEY ya está puesta; NO necesitas php artisan key:generate.
# =============================================================================

APP_NAME="Phone Colombia API"
APP_ENV=production
APP_KEY=base64:a/p2myjLEwL1iTkqxxPe5utOlEgGBrK71S6iL4lbf8E=
APP_DEBUG=false
APP_URL=https://api.phonecolombia.com
FRONTEND_URL=https://phonecolombia.com

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CAMBIA_NOMBRE_BD
DB_USERNAME=CAMBIA_USUARIO_BD
# Si la contraseña tiene *, #, $ u otros símbolos, SIEMPRE entre comillas:
DB_PASSWORD="CAMBIA_CONTRASEÑA"

FILESYSTEM_DISK=public

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=file
LOG_CHANNEL=stack
LOG_LEVEL=error
